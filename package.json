{
  "name": "tailnet-markdown-preview",
  "displayName": "Tailnet Markdown Preview",
  "description": "Serve the current Markdown file as a browser preview that Android devices can open over Tailscale.",
  "version": "0.1.0",
  "publisher": "datnguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/datvo06/tailnet-markdown-preview.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:tailnetMarkdownPreview.startCurrent",
    "onCommand:tailnetMarkdownPreview.start",
    "onCommand:tailnetMarkdownPreview.startViaTailscaleServe",
    "onCommand:tailnetMarkdownPreview.stop",
    "onCommand:tailnetMarkdownPreview.copyUrl",
    "onCommand:tailnetMarkdownPreview.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tailnetMarkdownPreview.startCurrent",
        "title": "Tailnet Markdown Preview: Start Current File",
        "category": "Tailnet Markdown Preview"
      },
      {
        "command": "tailnetMarkdownPreview.start",
        "title": "Tailnet Markdown Preview: Pick File and Start",
        "category": "Tailnet Markdown Preview"
      },
      {
        "command": "tailnetMarkdownPreview.startViaTailscaleServe",
        "title": "Tailnet Markdown Preview: Start with Tailscale Serve",
        "category": "Tailnet Markdown Preview"
      },
      {
        "command": "tailnetMarkdownPreview.stop",
        "title": "Tailnet Markdown Preview: Stop",
        "category": "Tailnet Markdown Preview"
      },
      {
        "command": "tailnetMarkdownPreview.copyUrl",
        "title": "Tailnet Markdown Preview: Copy URL",
        "category": "Tailnet Markdown Preview"
      },
      {
        "command": "tailnetMarkdownPreview.open",
        "title": "Tailnet Markdown Preview: Open Locally",
        "category": "Tailnet Markdown Preview"
      }
    ],
    "configuration": {
      "title": "Tailnet Markdown Preview",
      "properties": {
        "tailnetMarkdownPreview.port": {
          "type": "number",
          "default": 8787,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port used by the preview HTTP server."
        },
        "tailnetMarkdownPreview.hostMode": {
          "type": "string",
          "default": "tailnet",
          "enum": [
            "tailnet",
            "localhost"
          ],
          "enumDescriptions": [
            "Bind directly to this machine's Tailscale IPv4 address.",
            "Bind to 127.0.0.1. Use this with the Tailscale Serve command."
          ],
          "description": "Where the preview server should listen when using the normal start commands."
        },
        "tailnetMarkdownPreview.tailscaleBinary": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the Tailscale CLI. Leave empty to auto-detect."
        },
        "tailnetMarkdownPreview.allowHtml": {
          "type": "boolean",
          "default": false,
          "description": "Allow raw HTML inside Markdown. Keep this off for untrusted documents."
        },
        "tailnetMarkdownPreview.autoOpenLocalBrowser": {
          "type": "boolean",
          "default": false,
          "description": "Open the preview URL in the local browser when the server starts."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "tailnetMarkdownPreview.startCurrent",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile": "npm run typecheck && node scripts/build.mjs",
    "watch": "tsc -watch -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "hygiene": "node scripts/check-hygiene.mjs",
    "check": "npm run compile && npm run lint && npm run test && npm run hygiene",
    "package": "npm run check && vsce package"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.19.1",
    "@types/vscode": "^1.92.0",
    "@vscode/vsce": "^3.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
